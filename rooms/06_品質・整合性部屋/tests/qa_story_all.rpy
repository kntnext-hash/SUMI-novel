# Generated static expectations for the distributed story scripts.
init -90 python:
    import os as qa_os
    import json as qa_json
    import types as qa_types
    import sys as qa_sys
    import time as qa_time
    qa_state = qa_sys.modules.setdefault("_kaononaiharu_qa", qa_types.ModuleType("_kaononaiharu_qa"))
    qa_state.seen = set()
    qa_state.labels = set()
    qa_state.active = False
    qa_state.expected_mode = False
    qa_state.results = []
    qa_state.last_progress = 0.0
    qa_state.current_label = None


    with renpy.file("qa_image_expectations.json") as qa_handle:
        qa_image_rows = qa_json.load(qa_handle)
    qa_state.image_checked = set()
    qa_state.cues_checked = set()
    qa_state.image_coverage = {False: set(), True: set()}
    qa_state.expected_image = None

    def qa_image_begin(event, **kwargs):
        if event != "begin" or not qa_state.active:
            return
        filename, line = renpy.get_filename_line()
        key = qa_os.path.basename(filename) + ":" + str(line)
        row = qa_image_rows.get(key)
        if row is None:
            if qa_os.path.basename(filename).startswith("story"):
                raise AssertionError("Unmapped say location " + key)
            return
        cues = row["cues"]
        if cues:
            winner = cues[-1]
            qa_state.expected_image = winner["reread" if qa_state.expected_mode else "first"]
        expected = "black" if row["ending"] else qa_state.expected_image
        assert expected is not None, "No image expectation at " + key
        actual = sorted(" ".join((tag,) + tuple(renpy.get_attributes(tag, layer="master") or ()))
                        for tag in renpy.get_showing_tags(layer="master"))
        if actual != [expected]:
            record = dict(location=key, node=row["node"], index=row["index"],
                          reread=qa_state.expected_mode, expected=expected,
                          actual=actual, cues=cues)
            with open(qa_os.path.join(config.basedir, "qa_image_failure.json"), "w", encoding="utf-8") as handle:
                qa_json.dump(record, handle, ensure_ascii=False, indent=2)
            raise AssertionError("Image mismatch " + repr(record))
        qa_state.image_checked.add(key)
        for cue in cues:
            qa_state.cues_checked.add(cue["id"])
            qa_state.image_coverage[qa_state.expected_mode].add(cue["id"])

    config.all_character_callbacks.append(qa_image_begin)

    def qa_choice_ready(caption):
        for screen_name in ("choice", "nvl"):
            screen = renpy.get_screen(screen_name)
            if screen is not None:
                for item in screen.scope.get("items") or ():
                    if item.caption == caption and item.action is not None:
                        return True
        return False

    def qa_image_complete():
        for mode in (False, True):
            assert qa_state.image_coverage[mode] == set(range(1, 179)), repr(
                (mode, sorted(set(range(1, 179)) - qa_state.image_coverage[mode])))

    def qa_progress(event, location=None):
        record = dict(event=event, time=qa_time.time(), reread=qa_state.expected_mode,
                      label=qa_state.current_label, location=location,
                      visited_nodes=len(qa_state.labels), visited_statements=len(qa_state.seen),
                      completed_routes=len(qa_state.results))
        with open(qa_os.path.join(config.basedir, "qa_story_progress.jsonl"), "a", encoding="utf-8") as handle:
            handle.write(qa_json.dumps(record, ensure_ascii=False) + "\n")
        qa_state.last_progress = qa_time.monotonic()

    def qa_statement(name):
        if qa_state.active:
            filename, line = renpy.get_filename_line()
            if qa_os.path.basename(filename).startswith("story"):
                assert reread == qa_state.expected_mode, "Unexpected reading mode"
                qa_state.seen.add((qa_os.path.basename(filename), line))
                if qa_time.monotonic() - qa_state.last_progress >= 5:
                    qa_progress("statement", [filename, line])

    def qa_label(name, abnormal):
        if qa_state.active and name.startswith("node_"):
            qa_state.labels.add(name[5:])
            qa_state.current_label = name
            qa_progress("label")

    config.statement_callbacks.append(qa_statement)
    config.label_callbacks.append(qa_label)

    def qa_begin(mode):
        qa_state.image_checked = set()
        qa_state.cues_checked = set()
        qa_state.expected_image = None
        qa_state.expected_mode = mode
        if mode:
            assert persistent.unlocked_reread
        qa_state.seen = set()
        qa_state.labels = set()
        qa_state.active = True
        qa_state.current_label = None
        qa_progress("route_start")

    def qa_check(route, mode, expected_labels, expected_lines):
        missing_labels = set(expected_labels) - qa_state.labels
        missing_lines = set(map(tuple, expected_lines)) - qa_state.seen
        expected_images = {f + ":" + str(l) for f, l in expected_lines}
        missing_images = expected_images - qa_state.image_checked
        result = dict(route=route, reread=mode,
                      image_checked=sorted(qa_state.image_checked),
                      cue_ids_checked=sorted(qa_state.cues_checked),
                      missing_images=sorted(missing_images),
                      visited_labels=sorted(qa_state.labels),
                      visited_lines=sorted(qa_state.seen),
                      missing_labels=sorted(missing_labels),
                      missing_lines=sorted(missing_lines))
        qa_state.results.append(result)
        with open(qa_os.path.join(config.basedir, "qa_story_coverage.json"), "w", encoding="utf-8") as handle:
            qa_json.dump(qa_state.results, handle, ensure_ascii=False, indent=2)
        qa_state.active = False
        assert not missing_images, repr(missing_images)
        assert not missing_labels, repr(missing_labels)
        assert not missing_lines, repr(missing_lines)
        assert persistent.unlocked_reread

